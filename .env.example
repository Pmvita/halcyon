# Halcyon runs with every key blank.
# Embedded Postgres (PGlite) is used when DATABASE_URL is empty.
# In-memory cache and jobs are used when REDIS_URL is empty.

DATABASE_URL=
REDIS_URL=

# Optional canonical site origin for sitemap/robots (no trailing slash).
SITE_URL=

# Optional market-data keys. Never exposed to the browser.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
COINGECKO_API_KEY=

# Optional. When both are set, US stock fills may also be mirrored to Alpaca paper.
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=

# Optional. If empty, the server writes a local signing key to .data/session.key
SESSION_SECRET=
